  {
    "label": "Run Reactor GUI audit log - Individual Subsystem - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["run", "--release", "--", "--mode", "reactor"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
]
