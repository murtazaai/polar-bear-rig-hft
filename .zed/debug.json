// Project-local debug tasks
//
// For more documentation on how to configure debug tasks,
// see: https://zed.dev/docs/debugger
[
  {
    "label": "Clean polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["clean"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Lint (clippy) - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["clippy", "--all-targets", "--", "-D", "warnings"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Type-check only; no linking polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["check"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Browse rustdoc locally polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["doc", "--open", "--document-private-items"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "CI docs check",
    "build": {
      "command": "cargo",
      "args": ["doc", "--open"],
      "RUSTDOCFLAGS": ["--cfg", "docsrs", "-D", "warnings", "cargo", "doc"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  // ── Test tasks ─────────────────────────────────────────────────────────────
  // IMPORTANT: --skip-llm is a flag for the compiled binary (clap parser).
  // It must NEVER appear after -- in a cargo test invocation.
  // The Rust test harness uses getopts, not clap, and will reject it:
  //   error: Unrecognized option: 'skip-llm'
  // Use the SKIP_LLM=1 environment variable instead for all test tasks.
  {
    "label": "Test all deterministic tests - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["test"],
      "env": { "SKIP_LLM": "1" },
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Test with log output - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["test", "--", "--nocapture"],
      "env": { "SKIP_LLM": "1" },
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Test AVM Benchmarks - Single File - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["test", "--test", "test_avm_benchmark"],
      "env": { "SKIP_LLM": "1" },
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Test PEV Loop - Single File - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["test", "--test", "test_pev_loop"],
      "env": { "SKIP_LLM": "1" },
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Test Singer Context - Single File - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["test", "--test", "test_signer_context"],
      "env": { "SKIP_LLM": "1" },
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Test Smart Order Routing - Single File - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["test", "--test", "test_sor"],
      "env": { "SKIP_LLM": "1" },
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  // ── Binary run tasks ───────────────────────────────────────────────────────
  // --skip-llm belongs here: it is passed to the compiled binary via cargo run,
  // which passes it to clap. This is the ONLY correct place for this flag.
  {
    "label": "Build & Debug polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["build"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Release Build & Debug polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["build", "--release"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/release/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Run Binary - Full Pipeline - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "--mode",
        "full",
        "--pair",
        "SOL/USDC",
        "--amount",
        "1.0",
      ],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Run Binary - Full Pipeline (offline stub) - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--",
        "--mode",
        "full",
        "--skip-llm",
        "--pair",
        "SOL/USDC",
        "--amount",
        "1.0",
      ],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Run Plan-Execute-Verify - Individual Subsystem - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["run", "--release", "--", "--mode", "pev", "--skip-llm"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Run Smart Order Routing - Individual Subsystem - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["run", "--release", "--", "--mode", "sor"],
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/polar-bear-rig-hft",
    // sourceLanguages is required for CodeLLDB (not GDB) when using Rust
    "sourceLanguages": ["rust"],
    "request": "launch",
    "adapter": "CodeLLDB",
  },
  {
    "label": "Run On-chain Execution & SignerContext - Individual Subsystem - polar-bear-rig-hft",
    "build": {
      "command": "cargo",
      "args": ["run", "--release", "--", "--mode", "signer"],
